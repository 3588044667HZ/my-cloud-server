# my-cloud-server 配置示例：复制为 .env 后按需修改（真实环境变量优先于 .env）
# 修改路径后重启服务生效；SQLite 与文件首次启动自动创建。

# ---- 同步/落盘位置（多盘拓扑） ----

# 数据根目录：SQLite（core/notes/photos/drive.db）默认 data/
# 机械盘场景可放到本地盘，如 D:/my-cloud/data
# DATA_DIR=E:/my-cloud-server/data

# 相册文件根目录（orig/thumb 分桶），默认 {DATA_DIR}/photos
# 3T 大容量盘：相册原图+压缩图主存储
# PHOTOS_DIR=D:/photos

# 笔记附件目录，默认 {DATA_DIR}/files
# ATTACH_DIR=E:/my-cloud-server/data/files

# 笔记 txt 冷备目录，默认 backup/
# BACKUP_DIR=E:/my-cloud-server/backup

# ---- 其它常用 ----

# 管理后台密码（默认 admin123）
# ADMIN_PASSWORD=change-me

# 云盘显式共享映射 {盘名: 本地路径}，JSON 格式
# DRIVE_SHARES_JSON={"DATA":"D:/data","MEDIA":"E:/media"}
